;;
;; Guix channel definition for Enaction Engine
;;
;; To use this channel, add to ~/.config/guix/channels.scm:
;;
;;   (channel
;;     (name 'enaction-engine)
;;     (url "https://github.com/metadatastician/enaction-engine")
;;     (branch "main"))
;;
;; Then: guix pull

(channel
  (version 0)
  (url "https://github.com/metadatastician/enaction-engine")
  (dependencies
   (channel
     (name 'guix)
     (url "https://git.savannah.gnu.org/git/guix.git")
     (branch "master"))))
