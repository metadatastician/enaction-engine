# STATE.a2ml — Enaction Engine project-state checkpoint

[metadata]
project = "enaction-engine"
version = "0.3.0"
last-updated = "2026-08-04"
status = "active"
wiki = "docs/berrywiki/"
wiki-pages = 16
wiki-tool = "metadatastician/berrywiki"

[project-context]
name = "Enaction Engine"
purpose = "A deterministic, type-safe game engine for worlds shaped through perception, affect, intention, action and consequence."
current-scope = "Rust deterministic timing/interpolation substrate plus the cognitive trace seam: domain-typed, trope-particularised events with theory of mind and belief kinetics."
completion-percentage = 12

[position]
phase = "implementation"
maturity = "experimental"

[implemented]
components = [
  "fixed-timestep whole-step support",
  "render-only interpolation",
  "double buffering",
  "discontinuity handling",
  "Rust tests derived from IDApTIK experience",
  "domain-typed cognitive trace (Mechanical/Epistemic/Affective/Conative/BehaviouralSelection/SocialRelational)",
  "trope particularity: abstract particulars with identity, resemblance and peer queries",
  "theory of mind via ascription paths (Trope.holders), depth-bounded per the ESM contract",
  "theory-of-mind measurement: counterpart, divergence, projection queries",
  "interest/belief kinetics extracted from IDApTIK with bit-for-bit parity",
  "position-independent causality validation over the (tick, id) total order",
  "Mass bounded confidence type (ADR-0016), serde-guarded",
  "enaction-contracts: the ESM/CAC contract as types + package validator (ADR-0019)",
  "enaction-accelerator: operation-first planning + exact fixed-point and advisory pointwise CPU reference kernels (ADR-0020)",
  "enaction-accelerator-native: Idris2-defined ABI + pure-Zig scalar/Axiom-derived pointwise kernels + one audited Rust adapter",
  "belief store: Global Baseline + per-perspective deltas, keyed by full ascription path",
  "retraction as a first-class, caused, validator-enforced trace event",
]

[acceptance-evidence]
sally-anne = "The false-belief task runs as a test in enaction-trace: a stale belief is ascribed correctly because no provenance event reached its holder."
deception-discovery = "The failo scenario runs as a test: a covert move leaves a belief stale, contradicting evidence causes a Retract event, and the discovery moment is caused_by-linked in the trace while an uninformed observer still models the withdrawn belief."
guilty-conscience = "Chronicles' projection trap is a kernel query (Trace::projections), not a scripted beat."
idaptik-parity = "600 mixed-channel observed ticks and 10,000 decay steps compared f64-bit-for-bit against a verbatim reimplementation of IDApTIK expressions, using its committed constants."
test-count = 133

[not-implemented]
components = [
  "world and event substrate",
  "renderer or ECS",
  "physics and interaction",
  "audio, music, or input",
  "assets and content pipeline",
  "networking, multiplayer, persistence, or engine replay",
  "affective valence (only unsigned salience exists)",
  "conative goal, commitment and behavioural-selection machinery",
  "any game actually consuming the cognition seam",
  "Universal Modding Studio adapter or game profile",
  "AffineScript implementation",
]

[provenance]
first-proving-ground = "metadatastician/IDApTIK"
second-abstraction-test = "Chronicles of Slavia"
interpolation = "derived from IDApTIK experience"
fixed-step = "new engine code; not yet run in a real game"

[critical-next-actions]
actions = [
  "Validate enaction-time through a real game-host integration",
  "Preserve and extend timing/interpolation behavioural evidence",
  "Extract only implemented, tested seams that survive game-specific ontology",
]

[cross-repository-reconciliation]
coordination-id = "ums-idaptik-slavia-enaction-2026-07-25"
decision-status = "working direction recorded for the next agent; publication reconciliation remains"

