# STATE.a2ml — Enaction Engine project state

[metadata]
project = "enaction-engine"
version = "0.1.0"
last-updated = "2026-07-25"
status = "active"  # active | paused | archived

[project-context]
name = "enaction-engine"
purpose = "Deterministic runtime facilities: extracted interpolation, fixed-step policy and a small typed cognitive-affective-conative trace seam."
completion-percentage = 15

[position]
phase = "implementation"   # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts

[route-to-mvp]
milestones = [
  { name = "DoubleBuffer extracted from IDApTIK", completion = 100, evidence = "affective-time tests + idaptik_parity" },
  { name = "FixedStep accumulator", completion = 70, notes = "Tested here; not adopted by IDApTIK" },
  { name = "Typed cognitive-affective-conative seam", completion = 40, notes = "Serializable and tested; not adopted by either game" },
]

[blockers-and-issues]
# No active blockers

[critical-next-actions]
actions = [
  "Exercise FixedStep behind an IDApTIK adapter before proposing replacement",
  "Map a game-specific trace to enaction-cognition without importing narrative vocabulary",
  "Design field, relationship and world-memory primitives only from a second real slice",
]

[maintenance-status]
last-run-utc = "never"
last-report = "docs/reports/maintenance/latest.json"
last-result = "unknown"  # unknown | pass | warn | fail
open-warnings = 0
open-failures = 0

[ecosystem]
part-of = ["metadatastician game runtime architecture"]
depends-on = []
consumers = ["none required; IDApTIK interpolation is extraction provenance, not a Cargo dependency"]
