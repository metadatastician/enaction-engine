# ANCHOR.a2ml - authoritative anchor for this repository

[metadata]
version = "1.0.0"
last-updated = "2026-07-25"

[anchor]
schema = "hyperpolymath.anchor/1"
repo = "metadatastician/enaction-engine"
authority = "upstream-canonical"

purpose = [
  "Define canonical semantics and policy boundaries for this repository.",
  "Declare what downstream/satellite repos can extend but not redefine.",
  "Provide a stable golden path and invariant contract for release readiness.",
]

[identity]
project = "Enaction Engine"
kind = "game-engine"
one-sentence = "A deterministic, type-safe game engine for worlds shaped through perception, affect, intention, action and consequence."
domain = "games-and-interactive-simulation"

[semantic-authority]
policy = "canonical"

owns = [
  "Deterministic runtime invariants",
  "Engine subsystem boundaries and contracts",
  "Reference implementation behaviour",
]

[implementation-policy]
allowed = ["Rust", "Idris2", "Zig", "Scheme", "Shell", "Just", "AsciiDoc", "Markdown"]
forbidden = ["Node.js", "npm"]

[golden-path]
smoke-test-command = [
  "just test",
  "just verify",
]

success-criteria = [
  "Cargo workspace tests pass",
  "Formatting and Clippy gates pass",
  "RSR verification passes",
  "Documentation distinguishes implemented substrate from engine direction",
]

[satellite-policy]
must-pin-upstream = true
must-declare-authority = true
must-have-anchor = true
must-have-golden-path = true

[semantic-authority-files]
language-spec = "SPECIFICATION.md"
formal-proofs = "docs/proofs/PROOFS.adoc"
type-theory = "docs/theory/THEORY.adoc"
algorithms = "docs/theory/ALGORITHMS.adoc"
