# ECOSYSTEM.a2ml — Enaction Engine ecosystem position

[metadata]
project = "enaction-engine"
ecosystem = "hyperpolymath"
last-updated = "2026-08-04"

[position]
type = "game-engine"
purpose = "Deterministic, type-safe runtime facilities for situated agents and worlds."
what-this-is-not = [
  "a complete implemented engine today",
  "an affect-only simulation library",
  "a game-specific ontology",
  "the Universal Modding Studio authoring application",
]

[pipeline]
position = "runtime-infrastructure"
chain = "UMS Studio → UMS Core + game profile → validated package → game runtime → Enaction Engine runtime facilities"
notes = "The current implementation contains enaction-time (fixed-timestep stepping and render interpolation), enaction-trace (typed cognitive-affective-conative event seam), and enaction-contracts (the ESM/CAC contract as types: versioning, bounded confidence policy, provenance and package validation). Runtime/editor circular dependencies are forbidden."
coordination = "metadatastician"

[related-projects]
projects = [
  { name = "IDApTIK", relationship = "first-proving-ground", notes = "Source of interpolation experience and the first game-host integration target." },
  { name = "Chronicles of Slavia", relationship = "second-abstraction-test", notes = "Planned challenge to boundaries first discovered in IDApTIK." },
  { name = "Universal Modding Studio", relationship = "authoring-and-packaging", notes = "Integrates through versioned game profiles and optional adapters; not a runtime dependency." },
  { name = "AffineScript", relationship = "conditional-future-language", notes = "Adoption waits for a genuine release and typed-Wasm readiness." },
]
